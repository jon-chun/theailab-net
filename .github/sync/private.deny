# Hard denylist -- wins over the allowlist. Audited against B's tracked
# files by .github/sync/public_guard.py. Patterns are matched against
# repo-root-relative tracked paths using fnmatch-style globs (see guard).
dev/**
dev-notes/**
dev_notes/**
docs-project/**
emails/**                       # private class-email archive (PII: student names/addresses)
docs/**                         # decision 2
notes/**                        # decision 2
tools/**                        # private week generator (Phase 3)
dev/backups/**
.claude/**
.codex/**
.cursor/**
.gstack/**
.planning/**
.sync/**
.vscode/**
.gitattributes                  # A-only (merge=ours/theirs drivers for weeks/)
pyproject.toml                  # A-only (uv project for dev/sync-tests)
uv.lock                          # A-only (uv lockfile)
CLAUDE.md
AGENTS.md
.env
.env.*
.venv/**
.pytest_cache/**
__pycache__/**
node_modules/**
.DS_Store
weeks/*.md                      # decision 4 -- all week markdown is private source
weeks/state.json                # A-side generator state
weeks/test.html                 # stray test page, not linked from index.html or schedule
exercises/**                    # not linked from index.html; instructor/student materials
presentations/**                # not linked from index.html; lecture decks and notes
quizes/**                       # not linked from index.html; quiz drafts and prompts
manuals/**                      # not linked from index.html; lab and setup manuals
miniprojects/**                 # not linked from index.html; MP docs, student submissions and grades
*-notes.md
*.private.*
*.draft.*
_drafts/**
_wip/**
????-??-??-??????-*.txt         # CLI session transcripts
*.transcript.*
*.log
*.pem
*.key
