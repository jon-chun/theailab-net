#!/usr/bin/env bash
# Shared hook, identical in repo A (dev, private) and repo B (public site); .githooks/ is
# published A -> B verbatim (.github/sync/public.allow). Two stages:
#   1. the secret and transcript scan, `git-hook-scan` from ~/code/ai-swe-setup, when it is on PATH
#      (the scan then chains to stage 2 itself; a refused scan stops the commit or push);
#   2. this repository's own hook, <name>.local (public guard, stale weeks check, ...).
# Without git-hook-scan only stage 2 runs. This wrapper replaces the per-machine symlink of
# 2026-10-06, whose target differed between the MacBook and the Studio.
set -u
dir="$(cd "$(dirname "$0")" && pwd)"
name="$(basename "$0")"
if command -v git-hook-scan >/dev/null 2>&1; then
  GIT_HOOK_SCAN_DIR="$dir" exec git-hook-scan "$name" "$@"
fi
[ -x "$dir/$name.local" ] && exec "$dir/$name.local" "$@"
exit 0
