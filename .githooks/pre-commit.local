#!/usr/bin/env bash
# Shared pre-commit hook, used identically in repo A (dev, private) and
# repo B (public site). This file lives under .githooks/ which is synced
# A -> B verbatim (see .sync/public.allow), so the SAME script runs in
# both repos. Repo role is detected at runtime:
#   A (dev)    <=> a ".sync/" directory exists at the repo root
#   B (public) <=> no ".sync/" directory
#
# Contracts assumed (Phase 2 / Phase 3 land these in parallel; see report):
#   - python3 .github/sync/public_guard.py <repo_root> [--skip-gitleaks]
#       exit 0 clean, exit 1 with "VIOLATION <rule-id>: <path>" lines
#   - python3 tools/weeks/build_weeks.py --check
#       exit 1 with "STALE weeks/week-NN.html" lines if stale
#
# Exit non-zero to block the commit.

set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

is_repo_a=0
if [ -d "$repo_root/.sync" ]; then
  is_repo_a=1
fi

fail=0

if [ "$is_repo_a" -eq 1 ]; then
  # ---------------------------------------------------------------
  # Repo A (dev): secret scan + stale-generated-page check.
  # ---------------------------------------------------------------
  if command -v gitleaks >/dev/null 2>&1; then
    if ! gitleaks protect --staged --no-banner; then
      echo "pre-commit: gitleaks found a potential secret in staged changes; blocking commit." >&2
      fail=1
    fi
  else
    echo "pre-commit: WARNING: gitleaks not found on PATH; skipping secret scan." >&2
  fi

  if [ -f "$repo_root/tools/weeks/build_weeks.py" ]; then
    if ! python3 "$repo_root/tools/weeks/build_weeks.py" --check; then
      echo "pre-commit: one or more weeks/week-NN.html pages are stale vs their weeks/week-NN.md source; run tools/weeks/build_weeks.py and stage the result." >&2
      fail=1
    fi
  fi
else
  # ---------------------------------------------------------------
  # Repo B (public): run the public guard against the repo root.
  # ---------------------------------------------------------------
  guard_args=("$repo_root")
  if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: WARNING: gitleaks not found on PATH; running guard with --skip-gitleaks." >&2
    guard_args+=("--skip-gitleaks")
  fi

  if [ -f "$repo_root/.github/sync/public_guard.py" ]; then
    if ! python3 "$repo_root/.github/sync/public_guard.py" "${guard_args[@]}"; then
      echo "pre-commit: public_guard.py reported violations; blocking commit." >&2
      fail=1
    fi
  else
    echo "pre-commit: WARNING: .github/sync/public_guard.py not found; cannot verify public-safety. Blocking commit until the guard is present." >&2
    fail=1
  fi

  # Export staged paths touching week pages / manifest so commit-msg can
  # require a sync:/publish: prefix. pre-commit has no access to the
  # commit message file ($1 is not passed to pre-commit), so we hand the
  # list to commit-msg via a temp file under .git/.
  staged_week_paths=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^weeks/week-[0-9]{2}\.html$|^weeks/manifest\.json$' || true)

  tmp_file="$repo_root/.git/.pre-commit-week-paths"
  if [ -n "$staged_week_paths" ]; then
    printf '%s\n' "$staged_week_paths" > "$tmp_file"
  else
    rm -f "$tmp_file"
  fi
fi

if [ "$fail" -ne 0 ]; then
  exit 1
fi

exit 0
